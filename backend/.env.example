# ==============================================================================
# Sri Vidya E.M High School - Production Environment Configuration Template
# NOTE: Copy this file to .env and supply genuine production values.
# NEVER commit the actual .env file or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (INTERNAL DOCKER NETWORK - NOT PUBLICLY EXPOSED)
# ------------------------------------------------------------------------------
# Internal MongoDB URI within Docker network or private VPC
# Format: mongodb://<username>:<password>@<internal_host>:27017/<database_name>?authSource=admin
MONGODB_URI=mongodb://school_app_user:CHANGE_ME_STRONG_DB_PASSWORD@mongodb:27017/srividya_school_db?authSource=admin

# MongoDB root credentials (used only during container initialization)
MONGO_INITDB_ROOT_USERNAME=school_admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_ROOT_MONGO_PASSWORD
MONGO_INITDB_DATABASE=srividya_school_db

# ------------------------------------------------------------------------------
# 3. DOMAIN & CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of whitelisted frontend origins (Cloudflare / Custom Domains)
CORS_ORIGIN=https://srividya.edu,https://www.srividya.edu,https://portal.srividya.edu

# Domain name for Nginx SSL server block and Cloudflare DNS
DOMAIN_NAME=srividya.edu

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION SECRETS (Generate with: openssl rand -hex 64)
# ------------------------------------------------------------------------------
JWT_SECRET=GENERATE_RANDOM_HEX_64_KEY_DO_NOT_REUSE
JWT_EXPIRE=1h

JWT_REFRESH_SECRET=GENERATE_RANDOM_HEX_64_REFRESH_KEY_DO_NOT_REUSE
JWT_REFRESH_EXPIRE=7d

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY SECRETS
# ------------------------------------------------------------------------------
# Cryptographic secret for server-to-server webhook & transaction signature verification
PAYMENT_SECRET=GENERATE_RANDOM_HEX_64_HMAC_SECRET
PAYMENT_GATEWAY_KEY_ID=rzp_live_CHANGE_ME_KEY_ID
PAYMENT_GATEWAY_KEY_SECRET=CHANGE_ME_GATEWAY_SECRET

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & SECURITY THRESHOLDS
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_REQUESTS=10
PUBLIC_FORM_RATE_LIMIT_MAX=25
MAX_BODY_SIZE=1mb

# ------------------------------------------------------------------------------
# 7. LOGGING & MONITORING
# ------------------------------------------------------------------------------
LOG_LEVEL=info
TRUST_PROXY=1
